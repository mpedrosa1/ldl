TZ=America/Sao_Paulo

# Endereço do Home Assistant já existente no NAS (ex: IP do Tailscale, para
# funcionar mesmo fora da rede local: http://100.x.x.x:8123).
HA_URL=

# Perfil (canto inferior esquerdo, no HA) > Segurança > Long-Lived Access
# Tokens > Criar Token.
HA_TOKEN=

# Senha única de acesso ao LDL (login do app). Deixe em branco para manter o
# sistema aberto — nesse caso qualquer um que alcance o endereço controla a
# casa. Trocar esta senha desconecta todos os aparelhos.
APP_PASSWORD=
